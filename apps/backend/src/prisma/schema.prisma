generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String             @id @default(uuid())
  name          String
  owner_user_id String?            @unique
  created_at    DateTime           @default(now())
  owner         User?              @relation("OrganizationOwner", fields: [owner_user_id], references: [id], onDelete: Restrict)
  workspaces    Workspace[]
  roles         OrganizationRole[]
}

model Workspace {
  id           String       @id @default(uuid())
  org_id       String
  name         String
  organization Organization @relation(fields: [org_id], references: [id])
  departments  Department[]
}

model Department {
  id               String                     @id @default(uuid())
  workspace_id     String
  name             String
  description      String?
  is_default       Boolean                    @default(false)
  workspace        Workspace                  @relation(fields: [workspace_id], references: [id])
  authorized_users UserAuthorizedDepartment[]
  users            User[]
  documents        Document[]

  @@index([workspace_id])
}

model User {
  id                     String                     @id @default(uuid())
  department_id          String
  role_id                String
  email                  String                     @unique
  password_hash          String
  active                 Boolean                    @default(true)
  failed_login_attempts  Int                        @default(0)
  locked_until           DateTime?
  department             Department                 @relation(fields: [department_id], references: [id])
  role                   OrganizationRole           @relation(fields: [role_id], references: [id], onDelete: Restrict)
  owned_organization     Organization?              @relation("OrganizationOwner")
  authorized_departments UserAuthorizedDepartment[]
  documents              Document[]
  refresh_tokens         RefreshToken[]
  integration_tokens     IntegrationToken[]

  @@index([role_id])
}

model Document {
  id            String               @id @default(uuid())
  department_id String
  filename      String
  file_type     String
  status        String               @default("Indexed")
  stage         String               @default("Complete")
  progress      Int                  @default(100)
  chunk_count   Int                  @default(0)
  storage_key   String?
  uploaded_by   String
  created_at    DateTime             @default(now())
  department    Department           @relation(fields: [department_id], references: [id])
  uploader      User                 @relation(fields: [uploaded_by], references: [id])
  allowed_roles DocumentRoleAccess[]

  @@index([department_id])
}

model UserAuthorizedDepartment {
  user_id       String
  department_id String
  user          User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  department    Department @relation(fields: [department_id], references: [id], onDelete: Cascade)

  @@id([user_id, department_id])
  @@index([department_id])
}

model OrganizationRole {
  id              String               @id @default(uuid())
  org_id          String
  name            String
  permissions     String[]             @default([])
  is_owner        Boolean              @default(false)
  created_at      DateTime             @default(now())
  organization    Organization         @relation(fields: [org_id], references: [id], onDelete: Cascade)
  users           User[]
  document_access DocumentRoleAccess[]

  @@unique([org_id, name])
  @@index([org_id])
}

model DocumentRoleAccess {
  document_id String
  role_id     String
  document    Document         @relation(fields: [document_id], references: [id], onDelete: Cascade)
  role        OrganizationRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([document_id, role_id])
  @@index([role_id])
}

model AiRequestProgress {
  request_id String   @id
  user_id    String
  stage      String
  created_at DateTime @default(now())

  @@index([created_at])
}

model AiAnswerHistory {
  id         String   @id @default(uuid())
  request_id String   @unique
  user_id    String
  question   String
  answer     String
  sources    Json
  model      String
  has_answer Boolean
  created_at DateTime @default(now())

  @@index([user_id, created_at])
}

model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  token_hash String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model IntegrationToken {
  id            String    @id @default(uuid())
  user_id       String
  provider      String
  access_token  String
  refresh_token String?
  expires_at    DateTime?
  created_at    DateTime  @default(now())
  user          User      @relation(fields: [user_id], references: [id])

  @@unique([user_id, provider])
}
